# ==========================================
# ZIYO E-COMMERCE ENVIRONMENT CONFIGURATION
# ==========================================

# Core Django Settings
DJANGO_SECRET_KEY=ziyo-dev-insecure-key-replace-in-production-change-me-immediately-38491023
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# Database Settings (Leave empty for default SQLite in local development, or set PostgreSQL URL)
# Example PostgreSQL: postgresql://ziyo_app:secure_db_password@localhost:5432/ziyo_db
DATABASE_URL=

# Cache / Redis Settings
REDIS_URL=redis://localhost:6379/1

# Email Service (Console backend used when empty or in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Ziyo Support <noreply@ziyo.store>

# Razorpay Payment Gateway (Test Mode Keys for Sandbox)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=rzp_test_sample_key_secret
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_verification_token
RAZORPAY_CURRENCY=INR

# Google Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Site Profile
SITE_NAME=Ziyo
SITE_DOMAIN=http://127.0.0.1:8000
